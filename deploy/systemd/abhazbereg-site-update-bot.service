[Unit]
Description=Abhazbereg Telegram site update bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/srv/lending_pervyi
EnvironmentFile=/srv/lending_pervyi/.env.site-update-bot
ExecStart=/srv/lending_pervyi/.venv/bin/python /srv/lending_pervyi/scripts/site_update_bot.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target

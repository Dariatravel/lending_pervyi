# Telegram bot token from @BotFather.
SITE_UPDATE_BOT_TOKEN=1234567890:replace_me

# Comma-separated Telegram chat ids allowed to control the bot.
# Get your id from @userinfobot.
SITE_UPDATE_ALLOWED_CHAT_IDS=123456789

# Hourly check by default.
SITE_UPDATE_CHECK_INTERVAL_SECONDS=3600

# Safe default: hourly job only checks and sends notifications.
# Set to 1 only if you want the bot to auto-apply quick updates every hour.
SITE_UPDATE_AUTO_APPLY=0

# Production catalog source is data/catalog-snapshot.json.
SITE_UPDATE_SNAPSHOT_ONLY=1

# Long full sync can take hours.
SITE_UPDATE_COMMAND_TIMEOUT_SECONDS=21600

# Optional: override Telethon auth settings for scripts/watch_telegram_updates.py.
# Defaults match the existing project sync scripts.
TG_SESSION=/srv/lending_pervyi/tg_session
# TELEGRAM_API_ID=32916166
# TELEGRAM_API_HASH=replace_me
